{
  "manifest_version": 3,
  "name": "Auto Scroll Extension",
  "version": "1.0",
  "description": "Automatically scrolls the page based on user input.",
  "permissions": ["activeTab"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
