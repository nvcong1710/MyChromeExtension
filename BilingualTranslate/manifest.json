{
  "manifest_version": 3,
  "name": "Vimi Bilingual",
  "version": "2.1.1",
  "description": "Read webpages bilingually and build vocabulary: save words, review with spaced repetition, take tests. Free, private, on-device.",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Vimi Bilingual",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "store.js",
        "translation-card.js",
        "content.js",
        "subtitles.js",
        "mascot.js"
      ],
      "css": [
        "translation-card.css",
        "content.css",
        "subtitles.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "mascot/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "toggle-translate": {
      "suggested_key": {
        "default": "Alt+T",
        "mac": "Alt+T"
      },
      "description": "Toggle bilingual translation on the current page"
    }
  },
  "options_page": "options.html"
}
