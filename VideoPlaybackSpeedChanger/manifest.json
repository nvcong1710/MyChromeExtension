{
  "manifest_version": 3,
  "name": "Video Playback Speed Changer",
  "version": "1.3",
  "description": "Per-tab playback speed lock. Click the toolbar icon to open; press X to release.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
